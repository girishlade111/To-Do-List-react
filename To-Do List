import { useState, useEffect, useRef } from 'react'
import { motion } from 'framer-motion'
import { Button } from "/components/ui/button"
import { Input } from "/components/ui/input"
import { Checkbox } from "/components/ui/checkbox"
import { Trash, Paperclip, X, Sun, Moon } from 'lucide-react'
import { Card, CardContent, CardHeader, CardTitle } from "/components/ui/card"

type Attachment = {
  id: string
  name: string
  type: string
  size: number
  url: string
}

type Task = {
  id: string
  text: string
  completed: boolean
  attachments: Attachment[]
}

const backgroundConfig = {
  light: [
    {
      gradient: 'from-blue-100 via-purple-100 to-pink-100',
      shapes: [
        { color: 'bg-blue-200/20', size: 120, left: '10%', top: '20%' },
        { color: 'bg-purple-200/20', size: 80, left: '80%', top: '40%' },
        { color: 'bg-pink-200/20', size: 160, left: '30%', top: '70%' }
      ]
    },
    {
      gradient: 'from-amber-100 via-orange-100 to-red-100',
      shapes: [
        { color: 'bg-amber-200/20', size: 100, left: '70%', top: '10%' },
        { color: 'bg-orange-200/20', size: 140, left: '20%', top: '50%' },
        { color: 'bg-red-200/20', size: 60, left: '60%', top: '80%' }
      ]
    },
    {
      gradient: 'from-emerald-100 via-teal-100 to-cyan-100',
      shapes: [
        { color: 'bg-emerald-200/20', size: 90, left: '15%', top: '30%' },
        { color: 'bg-teal-200/20', size: 130, left: '75%', top: '60%' },
        { color: 'bg-cyan-200/20', size: 70, left: '40%', top: '20%' }
      ]
    }
  ],
  dark: [
    {
      gradient: 'from-gray-800 via-gray-700 to-gray-900',
      shapes: [
        { color: 'bg-gray-600/20', size: 120, left: '15%', top: '25%' },
        { color: 'bg-gray-500/20', size: 80, left: '75%', top: '45%' },
        { color: 'bg-gray-700/20', size: 160, left: '35%', top: '75%' }
      ]
    },
    {
      gradient: 'from-indigo-900 via-purple-900 to-pink-900',
      shapes: [
        { color: 'bg-indigo-800/20', size: 100, left: '80%', top: '15%' },
        { color: 'bg-purple-800/20', size: 140, left: '25%', top: '55%' },
        { color: 'bg-pink-800/20', size: 60, left: '65%', top: '85%' }
      ]
    },
    {
      gradient: 'from-blue-900 via-cyan-900 to-emerald-900',
      shapes: [
        { color: 'bg-blue-800/20', size: 90, left: '20%', top: '35%' },
        { color: 'bg-cyan-800/20', size: 130, left: '80%', top: '65%' },
        { color: 'bg-emerald-800/20', size: 70, left: '45%', top: '25%' }
      ]
    }
  ]
}

export default function TodoList() {
  const [tasks, setTasks] = useState<Task[]>([])
  const [newTask, setNewTask] = useState('')
  const [newAttachments, setNewAttachments] = useState<Attachment[]>([])
  const [darkMode, setDarkMode] = useState(false)
  const [bgIndex, setBgIndex] = useState(0)
  const fileInputRef = useRef<HTMLInputElement>(null)

  // Initialize theme
  useEffect(() => {
    const savedTheme = localStorage.getItem('theme')
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
    setDarkMode(savedTheme ? savedTheme === 'dark' : prefersDark)
    setBgIndex(Math.floor(Math.random() * 3))
  }, [])

  // Apply theme changes
  useEffect(() => {
    document.documentElement.classList.toggle('dark', darkMode)
    localStorage.setItem('theme', darkMode ? 'dark' : 'light')
  }, [darkMode])

  // Background rotation
  useEffect(() => {
    const interval = setInterval(() => {
      setBgIndex(prev => (prev + 1) % 3)
    }, 20000) // Change every 20 seconds
    return () => clearInterval(interval)
  }, [])

  // Load/save tasks
  useEffect(() => {
    const savedTasks = localStorage.getItem('tasks')
    if (savedTasks) setTasks(JSON.parse(savedTasks))
  }, [])

  useEffect(() => {
    localStorage.setItem('tasks', JSON.stringify(tasks))
  }, [tasks])

  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    if (e.target.files?.length) {
      const attachments = Array.from(e.target.files).map(file => ({
        id: Date.now().toString() + Math.random().toString(36).substring(2, 9),
        name: file.name,
        type: file.type.split('/')[0],
        size: file.size,
        url: URL.createObjectURL(file)
      }))
      setNewAttachments([...newAttachments, ...attachments])
    }
  }

  const addTask = () => {
    if (!newTask.trim() && !newAttachments.length) return
    
    setTasks([...tasks, {
      id: Date.now().toString(),
      text: newTask.trim(),
      completed: false,
      attachments: [...newAttachments]
    }])
    
    setNewTask('')
    setNewAttachments([])
    if (fileInputRef.current) fileInputRef.current.value = ''
  }

  const toggleTheme = () => setDarkMode(prev => !prev)
  const toggleTask = (id: string) => {
    setTasks(tasks.map(task => 
      task.id === id ? { ...task, completed: !task.completed } : task
    ))
  }
  const deleteTask = (id: string) => setTasks(tasks.filter(task => task.id !== id))
  const removeAttachment = (id: string) => {
    setNewAttachments(newAttachments.filter(att => att.id !== id))
  }

  const currentBg = darkMode ? backgroundConfig.dark[bgIndex] : backgroundConfig.light[bgIndex]

  return (
    <div className="min-h-screen py-12 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
      {/* Animated Background */}
      <div className="fixed inset-0 -z-50 overflow-hidden">
        {/* Gradient Background */}
        <motion.div
          key={`gradient-${darkMode}-${bgIndex}`}
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
          transition={{ duration: 1.5 }}
          className={`absolute inset-0 bg-gradient-to-br ${currentBg.gradient} transition-colors duration-1000`}
        />
        
        {/* Animated Shapes */}
        {currentBg.shapes.map((shape, index) => (
          <motion.div
            key={`shape-${darkMode}-${bgIndex}-${index}`}
            initial={{
              opacity: 0,
              x: -50,
              y: -50,
              rotate: Math.random() * 360
            }}
            animate={{
              opacity: 0.2,
              x: 0,
              y: 0,
              rotate: 360,
              transition: {
                duration: 30,
                repeat: Infinity,
                ease: "linear"
              }
            }}
            className={`absolute rounded-full blur-xl ${shape.color}`}
            style={{
              width: shape.size,
              height: shape.size,
              left: shape.left,
              top: shape.top
            }}
          />
        ))}
      </div>

      {/* Floating Particles */}
      <div className="fixed inset-0 -z-40 overflow-hidden pointer-events-none">
        {Array.from({ length: 30 }).map((_, i) => (
          <motion.div
            key={`particle-${i}`}
            initial={{
              x: Math.random() * 100,
              y: Math.random() * 100,
              opacity: 0
            }}
            animate={{
              x: Math.random() * 100,
              y: Math.random() * 100,
              opacity: 0.1,
              transition: {
                duration: Math.random() * 20 + 20,
                repeat: Infinity,
                repeatType: 'reverse',
                ease: "easeInOut"
              }
            }}
            className={`absolute rounded-full ${darkMode ? 'bg-white/10' : 'bg-black/10'}`}
            style={{
              width: `${Math.random() * 10 + 5}px`,
              height: `${Math.random() * 10 + 5}px`
            }}
          />
        ))}
      </div>

      {/* Main Content */}
      <div className="max-w-md mx-auto relative">
        <motion.div
          initial={{ y: 20, opacity: 0 }}
          animate={{ y: 0, opacity: 1 }}
          transition={{ duration: 0.5 }}
        >
          <Card className={`${darkMode ? 'dark:bg-gray-800/80 dark:border-gray-700' : 'bg-white/80'} backdrop-blur-lg`}>
            <CardHeader className="relative">
              <CardTitle className={`text-2xl font-bold text-center ${darkMode ? 'dark:text-white' : ''}`}>
                To-Do List
              </CardTitle>
              <Button 
                variant="ghost" 
                size="sm" 
                onClick={toggleTheme}
                className={`absolute right-4 top-4 ${darkMode ? 'text-gray-300 hover:bg-gray-700/50' : 'text-gray-500 hover:bg-gray-200/50'}`}
              >
                {darkMode ? <Sun className="h-5 w-5" /> : <Moon className="h-5 w-5" />}
              </Button>
            </CardHeader>
            
            <CardContent>
              {/* Task input */}
              <div className="flex gap-2 mb-2">
                <Input
                  value={newTask}
                  onChange={(e) => setNewTask(e.target.value)}
                  onKeyPress={(e) => e.key === 'Enter' && addTask()}
                  placeholder="Add a new task..."
                  className={darkMode ? 'dark:bg-gray-700/50 dark:border-gray-600 dark:text-white' : ''}
                />
                <Button onClick={addTask} className={darkMode ? 'dark:bg-blue-600/90' : ''}>
                  Add
                </Button>
              </div>

              {/* Attachments */}
              <div className="flex items-center mb-4">
                <Button 
                  variant="ghost" 
                  size="sm" 
                  onClick={() => fileInputRef.current?.click()}
                  className={darkMode ? 'dark:text-gray-300' : 'text-gray-500'}
                >
                  <Paperclip className="h-4 w-4 mr-2" />
                  Attach files
                </Button>
                <input
                  type="file"
                  ref={fileInputRef}
                  onChange={handleFileChange}
                  multiple
                  className="hidden"
                />
              </div>

              {/* Attachments preview */}
              {newAttachments.length > 0 && (
                <div className="mb-4">
                  <h3 className={`text-sm font-medium mb-2 ${darkMode ? 'dark:text-gray-300' : ''}`}>
                    Attachments:
                  </h3>
                  <div className="space-y-2">
                    {newAttachments.map(attachment => (
                      <div 
                        key={attachment.id} 
                        className={`flex items-center justify-between p-2 rounded ${darkMode ? 'dark:bg-gray-700/50' : 'bg-gray-100/90'}`}
                      >
                        <div className="flex items-center">
                          <div className={`border-2 border-dashed rounded-xl w-8 h-8 mr-2 ${darkMode ? 'dark:bg-gray-600/50' : 'bg-gray-200'}`}>
                            {attachment.type !== 'image' && (
                              <span className="text-xs flex items-center justify-center h-full">
                                {attachment.name.split('.').pop()}
                              </span>
                            )}
                          </div>
                          <span className="text-sm truncate max-w-[180px]">
                            {attachment.name}
                          </span>
                        </div>
                        <Button
                          variant="ghost"
                          size="sm"
                          onClick={() => removeAttachment(attachment.id)}
                        >
                          <X className="h-4 w-4" />
                        </Button>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {/* Task list */}
              {tasks.length === 0 ? (
                <p className={`text-center ${darkMode ? 'dark:text-gray-400' : 'text-gray-500'}`}>
                  No tasks yet. Add one above!
                </p>
              ) : (
                <ul className="space-y-3">
                  {tasks.map(task => (
                    <motion.li 
                      key={task.id}
                      initial={{ opacity: 0, y: 10 }}
                      animate={{ opacity: 1, y: 0 }}
                      transition={{ duration: 0.2 }}
                      className={`p-3 rounded-lg ${darkMode ? 'dark:bg-gray-700/50' : 'bg-white'}`}
                    >
                      <div className="flex items-start justify-between">
                        <div className="flex items-start space-x-3">
                          <Checkbox
                            checked={task.completed}
                            onCheckedChange={() => toggleTask(task.id)}
                            className={darkMode ? 'dark:border-gray-600' : ''}
                          />
                          <div>
                            <span className={`text-sm font-medium ${task.completed ? 'line-through' : ''} ${darkMode ? 'dark:text-gray-100' : ''}`}>
                              {task.text || 'Untitled task'}
                            </span>
                            {task.attachments.length > 0 && (
                              <div className="mt-2 space-y-2">
                                {task.attachments.map(attachment => (
                                  <div key={attachment.id} className="flex items-center">
                                    <div className={`border-2 border-dashed rounded-xl w-8 h-8 mr-2 ${darkMode ? 'dark:bg-gray-600/50' : 'bg-gray-200'}`}>
                                      {attachment.type !== 'image' && (
                                        <span className="text-xs flex items-center justify-center h-full">
                                          {attachment.name.split('.').pop()}
                                        </span>
                                      )}
                                    </div>
                                    <span className={`text-xs ${darkMode ? 'dark:text-gray-400' : ''}`}>
                                      {attachment.name}
                                    </span>
                                  </div>
                                ))}
                              </div>
                            )}
                          </div>
                        </div>
                        <Button
                          variant="ghost"
                          size="sm"
                          onClick={() => deleteTask(task.id)}
                          className={darkMode ? 'dark:text-red-400' : 'text-red-500'}
                        >
                          <Trash className="h-4 w-4" />
                        </Button>
                      </div>
                    </motion.li>
                  ))}
                </ul>
              )}
            </CardContent>
          </Card>
        </motion.div>
      </div>
    </div>
  )
}
